# ==========================================================================
# custom.rules — Network Intrusion Detection System (Task 4)
# Author: Naima
#
# Rule SID ranges used by this project: 9000000-9000999 (local/custom range,
# safely outside the Emerging Threats / Suricata official SID space so it
# never collides with community rules pulled via suricata-update).
#
# Each rule below targets a specific class of suspicious/malicious activity.
# classtype and priority follow Suricata's standard classification.conf.
# ==========================================================================

# --------------------------------------------------------------------------
# 1. RECONNAISSANCE — Port scanning
# --------------------------------------------------------------------------
# TCP SYN scan: many SYNs to different ports from one source in a short
# window. Suricata's flow/threshold keywords do the rate-limiting so this
# doesn't fire on a single normal connection.
alert tcp any any -> $HOME_NET any (msg:"CUSTOM Possible TCP SYN Port Scan"; flags:S,12; threshold:type both, track by_src, count 20, seconds 5; classtype:attempted-recon; sid:9000001; rev:1;)

# NULL scan (nmap -sN) — no flags set, never legitimate traffic
alert tcp any any -> $HOME_NET any (msg:"CUSTOM NULL Scan Detected"; flags:0; classtype:attempted-recon; sid:9000002; rev:1;)

# XMAS scan (nmap -sX) — FIN+PSH+URG set together
alert tcp any any -> $HOME_NET any (msg:"CUSTOM XMAS Scan Detected"; flags:FPU,12; classtype:attempted-recon; sid:9000003; rev:1;)

# FIN scan (nmap -sF)
alert tcp any any -> $HOME_NET any (msg:"CUSTOM FIN Scan Detected"; flags:F,12; classtype:attempted-recon; sid:9000004; rev:1;)

# --------------------------------------------------------------------------
# 2. DENIAL OF SERVICE / FLOODS
# --------------------------------------------------------------------------
alert icmp any any -> $HOME_NET any (msg:"CUSTOM ICMP Flood Detected"; itype:8; threshold:type both, track by_src, count 50, seconds 5; classtype:attempted-dos; sid:9000010; rev:1;)

alert tcp any any -> $HOME_NET any (msg:"CUSTOM Possible SYN Flood"; flags:S,12; threshold:type both, track by_dst, count 100, seconds 5; classtype:attempted-dos; sid:9000011; rev:1;)

alert udp any any -> $HOME_NET any (msg:"CUSTOM Possible UDP Flood"; threshold:type both, track by_dst, count 200, seconds 5; classtype:attempted-dos; sid:9000012; rev:1;)

# --------------------------------------------------------------------------
# 3. BRUTE FORCE — SSH / FTP authentication
# --------------------------------------------------------------------------
alert tcp any any -> $HOME_NET 22 (msg:"CUSTOM Possible SSH Brute Force"; flags:S; threshold:type both, track by_src, count 10, seconds 30; classtype:attempted-admin; sid:9000020; rev:1;)

alert tcp any any -> $HOME_NET 21 (msg:"CUSTOM Possible FTP Brute Force"; content:"530 "; threshold:type both, track by_src, count 5, seconds 30; classtype:attempted-admin; sid:9000021; rev:1;)

# --------------------------------------------------------------------------
# 4. WEB ATTACKS — SQL injection / directory traversal / XSS (HTTP layer)
# --------------------------------------------------------------------------
alert http any any -> $HOME_NET any (msg:"CUSTOM SQL Injection Attempt in URI"; flow:to_server,established; http.uri; pcre:"/(\%27)|(\')|(\-\-)|(\%23)|(#)/i"; classtype:web-application-attack; sid:9000030; rev:1;)

alert http any any -> $HOME_NET any (msg:"CUSTOM SQL Injection - UNION SELECT"; flow:to_server,established; http.uri; content:"UNION"; nocase; content:"SELECT"; nocase; distance:0; classtype:web-application-attack; sid:9000031; rev:1;)

alert http any any -> $HOME_NET any (msg:"CUSTOM Directory Traversal Attempt"; flow:to_server,established; http.uri; content:"../"; classtype:web-application-attack; sid:9000032; rev:1;)

alert http any any -> $HOME_NET any (msg:"CUSTOM Reflected XSS Attempt"; flow:to_server,established; http.uri; content:"<script"; nocase; classtype:web-application-attack; sid:9000033; rev:1;)

alert http any any -> $HOME_NET any (msg:"CUSTOM Suspicious User-Agent (scanner tool)"; flow:to_server,established; http.user_agent; content:"sqlmap"; nocase; classtype:web-application-attack; sid:9000034; rev:1;)
alert http any any -> $HOME_NET any (msg:"CUSTOM Suspicious User-Agent (nikto)"; flow:to_server,established; http.user_agent; content:"nikto"; nocase; classtype:web-application-attack; sid:9000035; rev:1;)

# --------------------------------------------------------------------------
# 5. MALWARE / C2 INDICATORS
# --------------------------------------------------------------------------
# Suspicious DNS query length (often seen in DNS tunneling / C2 beaconing)
alert dns any any -> any any (msg:"CUSTOM Possible DNS Tunneling - long query"; dns.query; pcre:"/^.{60,}$/"; classtype:trojan-activity; sid:9000040; rev:1;)

# Plaintext outbound connection carrying a known reverse-shell banner
alert tcp $HOME_NET any -> any any (msg:"CUSTOM Possible Reverse Shell Banner"; flow:to_server,established; content:"/bin/sh"; classtype:trojan-activity; sid:9000041; rev:1;)

# --------------------------------------------------------------------------
# 6. POLICY / HYGIENE
# --------------------------------------------------------------------------
alert tcp any any -> $HOME_NET 23 (msg:"CUSTOM Telnet Usage Detected (insecure protocol)"; flags:S; classtype:policy-violation; sid:9000050; rev:1;)
